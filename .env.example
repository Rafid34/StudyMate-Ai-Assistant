# ── Required ──────────────────────────────────────────────────────────────────
# Gemini API key — used for the LLM, Vision (OCR), embeddings, and Search grounding.
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# LangSmith API key — used for end-to-end tracing of the agent pipeline.
# Get yours at: https://smith.langchain.com/
LANGCHAIN_API_KEY=

# ── LangSmith tracing ─────────────────────────────────────────────────────────
# Set to false to disable tracing entirely.
LANGCHAIN_TRACING_V2=true
# Project name shown in the LangSmith dashboard.
LANGCHAIN_PROJECT=studymate

# ── Optional ──────────────────────────────────────────────────────────────────
# Tavily search API key — only needed when SEARCH_BACKEND=tavily.
# Get yours at: https://app.tavily.com/
TAVILY_API_KEY=

# Search provider: "gemini" (default, uses Gemini's built-in Google Search grounding)
# or "tavily" (uses the Tavily REST API; requires TAVILY_API_KEY above).
SEARCH_BACKEND=gemini

# Local path where ChromaDB persists the vector store.
CHROMA_DB_PATH=./data/chroma_db
